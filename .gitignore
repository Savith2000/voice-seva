# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bake-off harness
tools/asr-bakeoff/.venv/
tools/asr-bakeoff/__pycache__/
tools/asr-bakeoff/uv.lock
# recordings are large and personal — keep them local
tools/asr-bakeoff/audio/*

# Converted model weights: ~94 MB of derived artefact, regenerated in one command
# by tools/asr-bakeoff/export_onnx.py. Git is the wrong place for it.
public/models/
