# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bake-off harness
tools/asr-bakeoff/.venv/
tools/asr-bakeoff/__pycache__/
tools/asr-bakeoff/uv.lock
# recordings are large and personal — keep them local
tools/asr-bakeoff/audio/*

# Converted model weights: ~94 MB of derived artefact, regenerated in one command
# by tools/asr-bakeoff/export_onnx.py. Git is the wrong place for it.
public/models/

# python chant importer
tools/chant-import/.venv/
tools/chant-import/__pycache__/
tools/chant-import/uv.lock
# Intermediates: decoded.json is regenerated by decode_pdf.py, and fonts/ holds
# the extracted font programs and glyph charts used to derive the maps by eye.
tools/chant-import/decoded.json
tools/chant-import/fonts/

# Installed agent skills: 36 MB of third-party payload fetched by `npx skills
# add`, and reinstallable from skills-lock.json, which stays tracked because it
# is the record of what was pinned. .claude/skills is only symlinks into it —
# ignored by path so .claude/settings.json can still be committed.
.agents/
.claude/skills/

# Source chant PDFs. These are publishers' editions — whether to redistribute
# one is the owner's call, not a side effect of committing the importer. The
# decoded text lives in src/data/chants/ because the app needs it; the book
# does not. Put the PDF at the repo root to re-run tools/chant-import.
/*.pdf
